// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ReportStatus {
  PENDING   // Menunggu review
  PROCESSED // Diproses
  COMPLETED // Selesai
  REJECTED  // Ditolak
}

model Report {
  id                String       @id @default(cuid())
  ticketId          String       @unique // Format: KTR-XXXX-2026
  reporterInitials  String       // Inisial Pelapor (e.g., "A.R.", "NN") - Identitas disembunyikan
  violationType     String       // Jenis Pelanggaran (e.g., "smoking", "selling", "promotion", "signage", "ashtray")
  settingCategory   String       // Kategori Tatanan KTR (e.g., "fasyankes", "pendidikan", "anak", "ibadah", "angkutan", "kerja", "umum")
  violationLocation String       // Lokasi Pelanggaran
  description       String       // Deskripsi Kronologi Kejadian
  evidenceUrl       String?      // Bukti Pelanggaran (File upload path / URL)
  status            ReportStatus @default(PENDING)
  notes             String?      // Catatan Tindak Lanjut Petugas Satgas
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([ticketId])
  @@index([status])
}
